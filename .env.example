# Drone Platform Environment Variables
# Copy this file to .env and fill in real values

# Authentication (REQUIRED: at least 32 bytes)
AUTH_SECRET=replace-with-32-byte-random-secret

# Database (leave empty for in-memory storage, NOT FOR PRODUCTION)
DATABASE_URL=postgres://drone:drone_secret@localhost:5432/drone_platform?sslmode=disable

# WeChat Mini Program credentials
WECHAT_APPID=wx0000000000000000
WECHAT_APPSECRET=00000000000000000000000000000000

# Encryption key (optional, AES-256-GCM base64)
ENCRYPTION_KEY=

# Admin panel (set to true for local dev only)
ADMIN_DEV_MODE=false

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000

# Signing webhook secret
SIGNING_SECRET=

# Logging
LOG_DIR=./logs
LOG_LEVEL=info

# Server
HTTP_ADDR=:8080
ENV=development

# Super admin phone (auto-grants platform_admin role)
SUPER_ADMIN_PHONE=13800138000
