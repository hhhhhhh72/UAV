# Drone Platform Environment Variables
# Copy this file to .env and fill in real values
#
# ⚠️ 生产环境（ENV=production）以下变量为启动硬校验，缺失即拒绝启动：
#    AUTH_SECRET / DATABASE_URL / ENCRYPTION_KEY / SIGNING_SECRET，
#    且 ADMIN_DEV_MODE 必须为空或 false。

# Authentication (REQUIRED: at least 32 bytes)
AUTH_SECRET=replace-with-32-byte-random-secret

# Database (leave empty for in-memory storage, NOT FOR PRODUCTION)
DATABASE_URL=postgres://drone:drone_secret@localhost:5432/drone_platform?sslmode=disable
# compose 内 db 容器密码（与 DATABASE_URL 主机视角分离）
POSTGRES_PASSWORD=drone_secret

# WeChat Mini Program credentials
WECHAT_APPID=wx0000000000000000
WECHAT_APPSECRET=00000000000000000000000000000000

# Encryption key (REQUIRED in production; openssl rand -base64 32)
ENCRYPTION_KEY=

# Admin panel (set to true for local dev only; forbidden in production)
ADMIN_DEV_MODE=false

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000

# Signing webhook secret (REQUIRED in production; any long random string)
SIGNING_SECRET=

# banner 图片域名补全（生产如 https://api.cqnarc.cn）
BASE_URL=

# Logging
LOG_DIR=./logs
LOG_LEVEL=info

# Server
HTTP_ADDR=:8080
ENV=development

# Super admin phone (auto-grants platform_admin role; 占位值上线前必须修改)
SUPER_ADMIN_PHONE=13800138000
