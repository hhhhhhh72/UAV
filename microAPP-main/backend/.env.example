# ====================================
# 低空综合服务平台 - 环境变量配置
# ====================================
# 复制此文件为 .env 并填入实际配置值
# cp .env.example .env

# ====================================
# 服务器配置
# ====================================
PORT=3000
NODE_ENV=development

# ====================================
# JWT 认证配置
# ====================================
# IMPORTANT: 生产环境必须使用强随机字符串
# 生成方法: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-key-change-in-production
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=7d

# ====================================
# 超级管理员配置
# ====================================
SUPER_ADMIN_PHONE=wzdkjjfzyxgs
# 首次登录后通过界面修改密码，不要使用默认密码

# ====================================
# 微信小程序配置
# ====================================
WX_APPID=your-wechat-app-id
WX_SECRET=your-wechat-app-secret

# ====================================
# 微信公众号配置（用于H5网页授权登录）
# ====================================
# 注意：需要在微信公众号后台配置授权域名
WX_MP_APPID=your-wechat-mp-app-id
WX_MP_SECRET=your-wechat-mp-secret

# ====================================
# 服务器地址配置（用于微信OAuth回调）
# ====================================
# 后端服务地址（生产环境使用实际域名）
BASE_URL=http://localhost:3000
# 前端地址（生产环境使用实际域名）
FRONTEND_URL=http://localhost:5173

# ====================================
# 畅行温州 SSO 配置
# ====================================
SSO_API_URL=https://sso.example.com/api
SSO_API_KEY=your-sso-api-key

# ====================================
# PostgreSQL 数据库配置（可选）
# ====================================
# 设置为 1 启用 PostgreSQL，否则使用 JSON 文件存储
USE_POSTGRES=0

PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your-database-password
PG_DATABASE=lowaltitude
PG_SSL=false

# 或使用完整的连接字符串
# DATABASE_URL=postgresql://postgres:password@localhost:5432/lowaltitude

# ====================================
# 文件上传配置
# ====================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4,application/pdf

# ====================================
# 日志配置
# ====================================
LOG_LEVEL=info
LOG_DIR=./logs

# ====================================
# CORS 配置
# ====================================
CORS_ORIGIN=http://localhost:5173
# 生产环境设置为实际域名
# CORS_ORIGIN=https://microapp.zndkfx.com

# ====================================
# 缓存配置（未来扩展）
# ====================================
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=3600

# ====================================
# SM2 加密配置
# ====================================
# SM2 私钥（用于签名验证）
SM2_PRIVATE_KEY=
# SM2 公钥（用于签名验证）
SM2_PUBLIC_KEY=
