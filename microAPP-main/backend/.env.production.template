# ====================================
# 低空综合服务平台 - 正式环境配置模板
# ====================================
# 使用方法：
# 1. 复制此文件为 .env.production
# 2. 填入正式的微信公众号凭据和域名
# 3. 部署时使用：cp .env.production .env
# 
# 注意：.env.production 文件包含敏感信息，不要提交到 Git！
# 应该在 .gitignore 中添加：.env.production

# ====================================
# 服务器配置
# ====================================
PORT=3000
NODE_ENV=production

# ====================================
# JWT 认证配置
# ====================================
# 生成方法: openssl rand -hex 32
JWT_SECRET=请在此处填入生成的64位随机字符串
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=7d

# ====================================
# 超级管理员配置
# ====================================
SUPER_ADMIN_PHONE=wzdkjjfzyxgs

# ====================================
# 微信小程序配置
# ====================================
WX_APPID=正式小程序的AppID
WX_SECRET=正式小程序的AppSecret

# ====================================
# 微信公众号配置（用于H5网页授权登录）
# ====================================
# 要求：必须是已认证的服务号
# 配置：在微信公众平台设置网页授权域名为正式域名
WX_MP_APPID=正式公众号的AppID
WX_MP_SECRET=正式公众号的AppSecret

# ====================================
# 服务器地址配置（替换为正式域名）
# ====================================
BASE_URL=https://正式域名.com
FRONTEND_URL=https://正式域名.com

# ====================================
# 畅行温州 SSO 配置
# ====================================
SSO_API_URL=https://sso.example.com/api
SSO_API_KEY=正式环境的SSO密钥

# ====================================
# PostgreSQL 数据库配置
# ====================================
USE_POSTGRES=1

PG_HOST=数据库地址
PG_PORT=5432
PG_USER=数据库用户名
PG_PASSWORD=数据库密码
PG_DATABASE=lowaltitude
PG_SSL=true

# ====================================
# 文件上传配置
# ====================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4,application/pdf

# ====================================
# 日志配置
# ====================================
LOG_LEVEL=warn
LOG_DIR=./logs

# ====================================
# CORS 配置（设置为正式域名）
# ====================================
CORS_ORIGIN=https://正式域名.com

# ====================================
# SM2 加密配置
# ====================================
SM2_PRIVATE_KEY=
SM2_PUBLIC_KEY=
