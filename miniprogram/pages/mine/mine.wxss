.page { background: var(--gray-200); min-height: 100vh; padding-bottom: 32rpx; }
.header { background: linear-gradient(135deg, var(--blue-700), var(--blue-600)); padding: 64rpx var(--space-lg) var(--space-xl); display: flex; align-items: center; gap: var(--space-lg); }
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,0.3); }
.user-info { flex: 1; }
.name { color: var(--white); font-size: 36rpx; font-weight: 600; display: block; }
.role { color: rgba(255,255,255,0.7); font-size: var(--text-sm); margin-top: 4rpx; }
.btn-login { background: rgba(255,255,255,0.2); color: var(--white); border-radius: 32rpx; padding: 12rpx 32rpx; font-size: var(--text-sm); border: none; }

.wallet-card { background: var(--white); margin: -24rpx var(--space-md) var(--space-md); border-radius: var(--radius-md); padding: var(--space-lg); display: flex; box-shadow: var(--shadow-card); }
.wallet-item { flex: 1; text-align: center; }
.wallet-label { font-size: var(--text-xs); color: var(--gray-400); display: block; }
.wallet-value { font-size: 44rpx; font-weight: 700; color: var(--navy-900); display: block; margin-top: 8rpx; }
.wallet-value.sub { color: var(--gray-600); }

.menu-group { background: var(--white); margin: 0 var(--space-md) var(--space-md); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-card); }
.menu-item { display: flex; align-items: center; padding: var(--space-lg); gap: var(--space-md); }
.menu-item:not(:last-child) { border-bottom: 2rpx solid var(--gray-200); }
.menu-icon { font-size: 36rpx; }
.menu-name { flex: 1; font-size: var(--text-md); }
.menu-arrow { color: var(--gray-400); font-size: 40rpx; }
