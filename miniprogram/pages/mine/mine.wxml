<view class="page">
  <!-- 头部 -->
  <view class="header">
    <image class="avatar" src="{{user.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
    <view class="user-info">
      <text class="name">{{user.name || '点击登录'}}</text>
      <text class="role">{{roleText}}</text>
    </view>
    <button class="btn-login" wx:if="{{!isLogin}}" bindtap="onLogin">登录</button>
  </view>

  <!-- 钱包 -->
  <view class="wallet-card" wx:if="{{isLogin}}">
    <view class="wallet-item">
      <text class="wallet-label">可用余额</text>
      <text class="wallet-value">¥{{balance}}</text>
    </view>
    <view class="wallet-item">
      <text class="wallet-label">冻结金额</text>
      <text class="wallet-value sub">¥{{frozen}}</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-group">
    <view class="menu-item" wx:for="{{menus}}" wx:key="key" bindtap="onMenuTap" data-key="{{item.key}}">
      <text class="menu-icon">{{item.icon}}</text>
      <text class="menu-name">{{item.name}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-item" bindtap="onLogout" wx:if="{{isLogin}}">
      <text class="menu-icon">🚪</text>
      <text class="menu-name" style="color:var(--red-600)">退出登录</text>
    </view>
  </view>
</view>
