/* ═══ 首页 · 航空仪表盘 ═══ */

.page { padding-bottom: env(safe-area-inset-bottom); }

/* ── 顶部栏 ── */
.top-bar {
  display: flex;
  align-items: center;
  padding: var(--space-md) var(--space-lg);
  background: var(--blue-600);
  gap: var(--space-md);
}

.city-picker {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}
.city-icon { font-size: 28rpx; }
.city-name { color: var(--white); font-size: var(--text-md); font-weight: 500; }
.city-arrow { color: rgba(255,255,255,0.6); font-size: 24rpx; }

.search-btn {
  flex: 1;
  display: flex;
  align-items: center;
  height: 64rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 32rpx;
  padding: 0 var(--space-lg);
  gap: var(--space-sm);
}
.search-icon { font-size: 26rpx; }
.search-placeholder { color: rgba(255,255,255,0.5); font-size: var(--text-sm); }

/* ── 仪表盘 ── */
.instrument-panel {
  display: flex;
  background: linear-gradient(135deg, var(--blue-700), var(--blue-600));
  margin: var(--space-md) var(--space-md) 0;
  border-radius: var(--radius-lg);
  padding: var(--space-lg) var(--space-md);
}

.gauge {
  flex: 1;
  text-align: center;
  position: relative;
}
.gauge:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  height: 60%;
  width: 2rpx;
  background: rgba(255,255,255,0.15);
}
.gauge-value {
  display: block;
  color: var(--white);
  font-size: 44rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}
.gauge-label {
  display: block;
  color: rgba(255,255,255,0.7);
  font-size: 22rpx;
  margin-top: 4rpx;
}

/* ── 轮播 ── */
.banner {
  margin: var(--space-md);
  border-radius: var(--radius-md);
  overflow: hidden;
  height: 280rpx;
}
.banner-img {
  width: 100%;
  height: 100%;
}

/* ── 快捷入口 ── */
.quick-entries {
  display: flex;
  flex-wrap: wrap;
  background: var(--white);
  margin: 0 var(--space-md);
  border-radius: var(--radius-md);
  padding: var(--space-lg) var(--space-sm);
  box-shadow: var(--shadow-card);
}
.entry {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-sm) 0;
  gap: var(--space-sm);
}
.entry-icon {
  width: 72rpx;
  height: 72rpx;
}
.entry-name {
  font-size: 22rpx;
  color: var(--navy-900);
}

/* ── 需求列表 ── */
.demand-list {
  padding: 0 var(--space-md);
}
.demand-card {
  background: var(--white);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
  margin-bottom: var(--space-sm);
  box-shadow: var(--shadow-card);
}
.demand-title {
  font-size: var(--text-md);
  font-weight: 500;
  color: var(--navy-900);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.demand-budget {
  font-size: var(--text-lg);
  font-weight: 700;
  color: var(--amber-500);
  flex-shrink: 0;
  margin-left: var(--space-md);
}

/* ── 公告 ── */
.notice-list {
  margin: 0 var(--space-md);
  background: var(--white);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
  box-shadow: var(--shadow-card);
}
.notice-item {
  display: flex;
  align-items: center;
  padding: var(--space-sm) 0;
  gap: var(--space-sm);
}
.notice-item:not(:last-child) {
  border-bottom: 2rpx solid var(--gray-200);
}
.notice-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--blue-600);
  flex-shrink: 0;
}
.notice-text {
  font-size: var(--text-sm);
  color: var(--navy-900);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
