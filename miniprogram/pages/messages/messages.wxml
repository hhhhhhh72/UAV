<view class="page">
  <view class="msg-card" wx:for="{{messages}}" wx:key="id">
    <view class="flex-between">
      <text class="msg-title">{{item.title}}</text>
      <view class="dot" wx:if="{{!item.is_read}}"></view>
    </view>
    <text class="msg-content">{{item.content}}</text>
    <text class="text-muted text-small">{{item.created_at}}</text>
  </view>
  <view wx:if="{{messages.length === 0}}" class="empty-state">
    <text style="font-size:80rpx">📬</text>
    <text>暂无消息</text>
  </view>
</view>
