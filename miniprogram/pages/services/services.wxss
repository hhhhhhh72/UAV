.page { background: var(--gray-200); min-height: 100vh; }
.hero { background: linear-gradient(135deg, var(--blue-700), var(--blue-600)); padding: 48rpx var(--space-lg); color: var(--white); }
.hero-title { font-size: 40rpx; font-weight: 700; display: block; }
.hero-desc { font-size: var(--text-sm); opacity: 0.7; margin-top: 8rpx; }
.service-grid { display: flex; flex-wrap: wrap; padding: var(--space-md); gap: var(--space-sm); }
.service-card { width: calc(50% - 8rpx); background: var(--white); border-radius: var(--radius-md); padding: var(--space-lg); box-shadow: var(--shadow-card); }
.service-icon { font-size: 48rpx; display: block; }
.service-name { font-size: var(--text-md); font-weight: 600; color: var(--navy-900); display: block; margin-top: var(--space-sm); }
.service-desc { font-size: var(--text-xs); color: var(--gray-600); display: block; margin-top: 4rpx; }
