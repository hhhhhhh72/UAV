.page { background: var(--gray-200); min-height: 100vh; padding-bottom: 120rpx; }
.image-swiper { width: 100%; height: 480rpx; }
.swiper-img { width: 100%; height: 100%; }
.info-card { background: var(--white); margin: var(--space-md); border-radius: var(--radius-md); padding: var(--space-lg); box-shadow: var(--shadow-card); }
.title { font-size: 36rpx; font-weight: 600; color: var(--navy-900); display: block; margin: var(--space-sm) 0; }
.desc { font-size: var(--text-md); color: var(--gray-600); line-height: 1.8; margin-top: var(--space-sm); }
.info-grid { display: flex; margin-top: var(--space-lg); padding-top: var(--space-lg); border-top: 2rpx solid var(--gray-200); }
.info-item { flex: 1; text-align: center; }
.info-label { display: block; font-size: var(--text-xs); color: var(--gray-400); }
.info-value { display: block; font-size: var(--text-md); color: var(--navy-900); margin-top: 4rpx; font-weight: 500; }
.info-value.price { color: var(--amber-500); font-weight: 700; font-size: var(--text-lg); }
.section-header { margin: var(--space-lg) var(--space-md) var(--space-sm); }
.section-title { font-size: var(--text-lg); font-weight: 600; }
.bid-list { padding: 0 var(--space-md); }
.bid-card { background: var(--white); border-radius: var(--radius-md); padding: var(--space-lg); margin-bottom: var(--space-sm); box-shadow: var(--shadow-card); }
.bidder-name { font-size: var(--text-md); font-weight: 500; }
.bid-amount { font-size: var(--text-lg); font-weight: 700; color: var(--blue-600); }
.bid-proposal { display: block; font-size: var(--text-sm); color: var(--gray-600); margin: var(--space-sm) 0; }
.action-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: var(--space-md) var(--space-lg); padding-bottom: calc(var(--space-lg) + env(safe-area-inset-bottom)); background: var(--white); border-top: 2rpx solid var(--gray-200); display: flex; gap: var(--space-md); }
.action-bar .btn { flex: 1; }
.empty-state { padding: 60rpx 0; text-align: center; color: var(--gray-400); }
