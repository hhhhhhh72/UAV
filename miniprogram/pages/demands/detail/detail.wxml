<view class="page">
  <!-- 图片轮播 -->
  <swiper wx:if="{{demand.images && demand.images.length}}" class="image-swiper" indicator-dots>
    <swiper-item wx:for="{{demand.images}}" wx:key="*this">
      <image src="{{item}}" mode="aspectFill" class="swiper-img" />
    </swiper-item>
  </swiper>

  <!-- 基本信息 -->
  <view class="info-card">
    <view class="flex gap-sm" style="margin-bottom:16rpx">
      <text class="tag tag-blue">{{bizTypeText}}</text>
      <text class="tag tag-amber">{{demand.district}}</text>
      <text class="tag tag-green" wx:if="{{demand.status === 'published'}}">进行中</text>
    </view>
    <text class="title">{{demand.title}}</text>
    <text class="desc">{{demand.description || '暂无描述'}}</text>

    <view class="info-grid">
      <view class="info-item">
        <text class="info-label">预算</text>
        <text class="info-value price">¥{{budgetText}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">发布者</text>
        <text class="info-value">{{demand.publisher_name}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">发布时间</text>
        <text class="info-value">{{demand.created_at}}</text>
      </view>
    </view>
  </view>

  <!-- 竞标列表 -->
  <view class="section-header">
    <text class="section-title">竞标报价 ({{bids.length}})</text>
  </view>
  <view class="bid-list">
    <view class="bid-card" wx:for="{{bids}}" wx:key="id">
      <view class="flex-between">
        <text class="bidder-name">{{item.bidder_name}}</text>
        <text class="bid-amount">¥{{(item.amount_fen / 100).toFixed(0)}}</text>
      </view>
      <text class="bid-proposal">{{item.proposal}}</text>
      <text class="text-muted text-small">{{item.created_at}}</text>
    </view>
    <view wx:if="{{bids.length === 0}}" class="empty-state">
      <text style="font-size:60rpx">📝</text>
      <text>暂无报价</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar" wx:if="{{isOwner || !isOwner}}">
    <button class="btn btn-primary" wx:if="{{canBid}}" bindtap="onBidTap">我要报价</button>
    <button class="btn btn-outline" wx:if="{{canSelect}}" bindtap="onCompleteTap">确认完成</button>
  </view>
</view>
