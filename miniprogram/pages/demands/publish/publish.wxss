.page { background: var(--gray-200); min-height: 100vh; padding-bottom: 120rpx; }
.form { padding: var(--space-md); }
.form-group { background: var(--white); border-radius: var(--radius-md); padding: var(--space-lg); margin-bottom: var(--space-sm); box-shadow: var(--shadow-card); }
.label { font-size: var(--text-sm); color: var(--gray-600); display: block; margin-bottom: var(--space-sm); }
.input { width: 100%; height: 72rpx; font-size: var(--text-md); border-bottom: 2rpx solid var(--gray-200); }
.textarea { width: 100%; min-height: 160rpx; font-size: var(--text-md); }
.picker { height: 72rpx; line-height: 72rpx; font-size: var(--text-md); color: var(--navy-900); border-bottom: 2rpx solid var(--gray-200); }
.submit-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: var(--space-md) var(--space-lg); padding-bottom: calc(var(--space-lg) + env(safe-area-inset-bottom)); background: var(--white); border-top: 2rpx solid var(--gray-200); }
.submit-bar .btn { width: 100%; }
