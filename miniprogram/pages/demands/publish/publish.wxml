<view class="page">
  <view class="form">
    <view class="form-group"><text class="label">需求标题 *</text><input class="input" placeholder="例如:南岸区线路巡检作业" value="{{title}}" bindinput="onField" data-field="title" /></view>
    <view class="form-group"><text class="label">业务类型 *</text>
      <picker mode="selector" range="{{bizTypes}}" range-key="name" bindchange="onTypeChange">
        <view class="picker">{{selectedType || '请选择'}}</view>
      </picker>
    </view>
    <view class="form-group"><text class="label">所在区域 *</text><input class="input" placeholder="例如:南岸区" value="{{district}}" bindinput="onField" data-field="district" /></view>
    <view class="form-group"><text class="label">预算金额 (元)</text><input class="input" type="digit" placeholder="0" value="{{budget}}" bindinput="onField" data-field="budget" /></view>
    <view class="form-group"><text class="label">详细描述</text><textarea class="textarea" placeholder="请描述具体需求和作业要求" value="{{description}}" bindinput="onField" data-field="description" /></view>
    <view class="form-group"><text class="label">联系人 *</text><input class="input" placeholder="手机号" value="{{contact}}" bindinput="onField" data-field="contact" /></view>
  </view>
  <view class="submit-bar"><button class="btn btn-primary" bindtap="onSubmit">发布需求</button></view>
</view>
