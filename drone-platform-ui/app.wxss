/* 全局样式 - 无人机平台 */
page {
  --primary: #4a90d9;
  --primary-dark: #357abd;
  --danger: #ff4d4f;
  --warning: #ff9800;
  --success: #52c41a;
  --bg: #f5f7fa;
  --card-bg: #ffffff;
  --text: #1a1a1a;
  --text-secondary: #666666;
  --text-muted: #999999;
  --border: #f0f0f0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background: var(--bg);
  color: var(--text);
}

.container {
  min-height: 100vh;
  background: var(--bg);
}

/* 渐变头部 */
.gradient-header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  border-radius: 0 0 24px 24px;
}

/* 卡片 */
.card {
  background: var(--card-bg);
  border-radius: 16px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.04);
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 600;
}
.tag-blue { background: #e3f2fd; color: #1976d2; }
.tag-orange { background: #fff3e0; color: #f57c00; }
.tag-green { background: #e8f5e9; color: #388e3c; }

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: white;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 600;
  padding: 6px 18px;
}

.btn-outline {
  border: 1px solid #d9d9d9;
  color: #666;
  border-radius: 20px;
  font-size: 12px;
  padding: 6px 14px;
}

/* 价格 */
.price {
  color: var(--danger);
  font-size: 20px;
  font-weight: 800;
}
.price-symbol {
  color: var(--danger);
  font-size: 12px;
  font-weight: 700;
}

/* Tab */
.tab-active {
  background: var(--primary);
  color: white;
  border-radius: 20px;
  padding: 6px 16px;
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
}
.tab-normal {
  background: #f0f0f0;
  color: #666;
  border-radius: 20px;
  padding: 6px 16px;
  font-size: 13px;
  font-weight: 500;
  white-space: nowrap;
}

/* 滚动隐藏 */
.hide-scrollbar::-webkit-scrollbar { display: none; }
.hide-scrollbar { scrollbar-width: none; }

/* 公告滚动 */
@keyframes scrollNotice {
  0% { transform: translateX(100%); }
  100% { transform: translateX(-100%); }
}
.notice-scroll {
  animation: scrollNotice 12s linear infinite;
}
