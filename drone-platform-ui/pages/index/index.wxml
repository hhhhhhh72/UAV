<view class="container">
  <!-- 状态栏占位 -->
  <view style="height:{{statusBarHeight}}px;background:linear-gradient(135deg,#4a90d9,#357abd);"></view>

  <!-- 头部 -->
  <view class="gradient-header" style="padding:0 16px 20px;">
    <view style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <view style="display:flex;align-items:center;gap:4px;color:white;font-size:15px;font-weight:600;" bindtap="onCityTap">
        <text class="iconfont icon-location"></text>
        <text>{{city}}</text>
        <text class="iconfont icon-arrow-down"></text>
      </view>
      <view style="display:flex;gap:12px;align-items:center;">
        <view class="header-icon">APP</view>
        <view class="header-icon"><text class="iconfont icon-bell"></text></view>
        <view class="header-icon"><text class="iconfont icon-scan"></text></view>
      </view>
    </view>
    <view style="display:flex;gap:8px;align-items:center;">
      <view style="flex:1;background:rgba(255,255,255,0.95);border-radius:24px;height:40px;display:flex;align-items:center;padding:0 16px;gap:8px;" bindtap="onSearchFocus">
        <text class="iconfont icon-search" style="color:#999;"></text>
        <text style="color:#999;font-size:14px;">{{keyword || '航拍机 · 测绘与影像'}}</text>
      </view>
      <view style="width:64px;height:40px;background:#2c5aa0;border-radius:24px;display:flex;align-items:center;justify-content:center;color:white;font-size:14px;font-weight:600;">搜索</view>
    </view>
  </view>

  <!-- Banner -->
  <swiper class="banner-swiper" indicator-dots autoplay interval="3000" style="margin:16px;height:160px;border-radius:16px;overflow:hidden;">
    <swiper-item wx:for="{{banners}}" wx:key="id" bindtap="onBannerTap" data-item="{{item}}">
      <image src="{{item.image_url}}" mode="aspectFill" style="width:100%;height:100%;" />
      <view class="banner-text">
        <view class="banner-title">{{item.title}}</view>
        <view class="banner-sub">{{item.subtitle}}</view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 公告 -->
  <view class="card" style="margin:0 16px 12px;padding:10px 14px;display:flex;align-items:center;gap:10px;">
    <view style="width:28px;height:28px;background:#fff3e0;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
      <text class="iconfont icon-speaker" style="color:#ff9800;font-size:14px;"></text>
    </view>
    <view style="flex:1;display:flex;align-items:center;gap:8px;overflow:hidden;">
      <text style="color:var(--primary);font-size:13px;font-weight:700;flex-shrink:0;">最新公告</text>
      <text style="width:1px;height:12px;background:#e0e0e0;flex-shrink:0;"></text>
      <view style="flex:1;overflow:hidden;position:relative;height:20px;">
        <view class="notice-scroll" style="position:absolute;white-space:nowrap;color:#666;font-size:13px;">{{notice}}</view>
      </view>
    </view>
    <text style="color:#999;font-size:12px;flex-shrink:0;">2026/4/30</text>
  </view>

  <!-- 快捷入口 -->
  <view class="card" style="margin:0 16px 16px;padding:16px;">
    <view class="quick-grid">
      <view class="quick-item" wx:for="{{quickEntries}}" wx:key="key" bindtap="onQuickEntry" data-item="{{item}}">
        <view class="quick-icon" style="background:{{item.bg}};box-shadow:{{item.shadow}};">{{item.icon}}</view>
        <text class="quick-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 供需双广场 -->
  <view style="margin:0 16px 16px;">
    <view style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <view style="display:flex;align-items:center;gap:8px;">
        <view style="width:4px;height:16px;background:var(--primary);border-radius:2px;"></view>
        <text style="font-size:16px;font-weight:700;">供需双广场</text>
      </view>
      <text style="font-size:13px;color:#999;" bindtap="onMoreDemand">精选服务 ></text>
    </view>
    <view class="plaza-grid">
      <view class="plaza-card" bindtap="showToast" data-msg="商家发单">
        <view class="plaza-title">商家发单</view>
        <view class="plaza-desc">航拍、植保、巡检
需求一键发布</view>
        <view style="display:flex;justify-content:space-between;align-items:flex-end;">
          <view class="btn-primary" style="padding:6px 14px;font-size:12px;">发布任务</view>
          <text style="font-size:28px;">🚁</text>
        </view>
      </view>
      <view class="plaza-card" bindtap="showToast" data-msg="飞手接单">
        <view class="plaza-title">飞手接单</view>
        <view class="plaza-desc">海量任务派单
等待客户联系</view>
        <view style="display:flex;justify-content:space-between;align-items:flex-end;">
          <view style="padding:6px 14px;background:var(--success);color:white;border-radius:20px;font-size:12px;font-weight:600;">接单入驻</view>
          <text style="font-size:28px;">👨‍✈️</text>
        </view>
      </view>
      <view class="plaza-card small" bindtap="showToast" data-msg="二手无人机">
        <view>
          <view class="plaza-title">二手无人机</view>
          <text style="font-size:12px;color:var(--primary);font-weight:600;">去选购 ></text>
        </view>
        <text style="font-size:32px;">🛸</text>
      </view>
      <view class="plaza-card small" bindtap="showToast" data-msg="无人机配件">
        <view>
          <view class="plaza-title">无人机配件</view>
          <text style="font-size:12px;color:var(--primary);font-weight:600;">去选购 ></text>
        </view>
        <text style="font-size:32px;">⚙️</text>
      </view>
    </view>
  </view>

  <!-- 需求大厅 -->
  <view style="margin:0 16px 12px;">
    <view style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <view style="display:flex;align-items:center;gap:8px;">
        <view style="width:4px;height:16px;background:var(--primary);border-radius:2px;"></view>
        <text style="font-size:16px;font-weight:700;">需求大厅</text>
      </view>
      <text style="font-size:13px;color:#999;" bindtap="onMoreDemand">更多 ></text>
    </view>
    <scroll-view scroll-x class="hide-scrollbar" style="display:flex;gap:8px;white-space:nowrap;">
      <view wx:for="{{bizTypeTabs}}" wx:key="value" 
        class="{{currentBizType === item.value ? 'tab-active' : 'tab-normal'}}"
        style="display:inline-block;margin-right:8px;"
        bindtap="onBizTypeChange" data-value="{{item.value}}">
        {{item.label}}
      </view>
    </scroll-view>
  </view>

  <!-- 需求列表 -->
  <view style="margin:0 16px;">
    <view class="demand-card" wx:for="{{demands}}" wx:key="id" bindtap="onDemandTap" data-item="{{item}}">
      <view style="display:flex;gap:10px;margin-bottom:10px;">
        <image src="{{item.images[0] || '/images/default-demand.png'}}" mode="aspectFill" style="width:100px;height:80px;border-radius:10px;flex-shrink:0;background:#f5f5f5;" />
        <view style="flex:1;min-width:0;">
          <view style="display:flex;gap:6px;margin-bottom:6px;">
            <view class="tag tag-blue">{{item.bizTypeLabel}}</view>
            <view class="tag tag-orange">待接单</view>
          </view>
          <view class="demand-title">{{item.title}}</view>
          <view style="display:flex;align-items:center;gap:4px;color:#999;font-size:12px;">
            <text class="iconfont icon-location"></text>
            <text style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{item.location || '重庆市'}}</text>
          </view>
        </view>
      </view>
      <view style="display:flex;align-items:center;justify-content:space-between;">
        <view style="display:flex;align-items:baseline;gap:2px;">
          <text class="price-symbol">¥</text>
          <text class="price">{{item.priceText}}</text>
        </view>
        <view style="display:flex;gap:8px;">
          <view class="btn-outline" catchtap="showToast" data-msg="查看附近飞手">
            <text class="iconfont icon-location" style="margin-right:2px;"></text>查看附近飞手
          </view>
          <view class="btn-primary" catchtap="showToast" data-msg="去抢单">去抢单</view>
        </view>
      </view>
      <view wx:if="{{item.description}}" style="margin-top:8px;padding:8px;background:#f8f9fa;border-radius:8px;font-size:12px;color:#666;line-height:1.5;">{{item.description}}</view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view wx:if="{{loadingMore}}" style="text-align:center;padding:16px;color:#999;font-size:13px;">
    <view style="display:inline-block;width:16px;height:16px;border:2px solid #e0e0e0;border-top-color:var(--primary);border-radius:50%;animation:spin 0.8s linear infinite;margin-right:8px;vertical-align:middle;"></view>
    加载中...
  </view>
  <view wx:if="{{!hasMore && demands.length > 0}}" style="text-align:center;padding:16px;color:#999;font-size:13px;">—— 到底了 ——</view>
</view>
