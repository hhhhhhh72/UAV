<view class="container">
  <view style="background:#fff;padding:10px 16px;display:flex;align-items:center;gap:10px;border-bottom:1px solid #f0f0f0;position:sticky;top:0;z-index:10;">
    <view style="display:flex;align-items:center;gap:4px;color:#333;font-size:14px;font-weight:600;" bindtap="showToast" data-msg="切换城市">
      <text class="iconfont icon-location"></text>
      <text>全国</text>
      <text class="iconfont icon-arrow-down" style="font-size:10px;"></text>
    </view>
    <view style="flex:1;background:#f5f5f5;border-radius:20px;height:36px;display:flex;align-items:center;padding:0 14px;gap:8px;" bindtap="showToast" data-msg="搜索">
      <text class="iconfont icon-search" style="color:#999;font-size:14px;"></text>
      <text style="color:#999;font-size:13px;">搜一搜心仪机型</text>
    </view>
    <view style="display:flex;gap:3px;">
      <view style="width:5px;height:5px;background:#333;border-radius:50%;"></view>
      <view style="width:5px;height:5px;background:#333;border-radius:50%;"></view>
      <view style="width:5px;height:5px;background:#333;border-radius:50%;"></view>
    </view>
  </view>

  <!-- 附近商家 -->
  <view style="padding:16px;background:#fff;margin-bottom:10px;">
    <view style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
      <view style="width:20px;height:20px;background:#ff9800;border-radius:50%;display:flex;align-items:center;justify-content:center;">
        <text class="iconfont icon-location" style="color:white;font-size:12px;"></text>
      </view>
      <text style="font-size:15px;font-weight:700;color:var(--primary);">附近商家</text>
      <text style="font-size:13px;color:#999;">服务站点</text>
      <text style="margin-left:auto;font-size:13px;color:#999;" bindtap="showToast" data-msg="全部商家">全部 ></text>
    </view>
    <scroll-view scroll-x class="hide-scrollbar" style="white-space:nowrap;">
      <view wx:for="{{shops}}" wx:key="id" style="display:inline-block;width:70px;text-align:center;margin-right:10px;" bindtap="showToast" data-msg="{{item.name}}">
        <image src="{{item.logo}}" style="width:56px;height:56px;border-radius:12px;background:#f0f0f0;" mode="aspectFill" />
        <view style="font-size:11px;color:#333;margin-top:6px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{item.name}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 筛选栏 -->
  <view style="display:flex;align-items:center;padding:10px 16px;background:#fff;border-bottom:1px solid #f0f0f0;gap:12px;position:sticky;top:57px;z-index:10;">
    <view style="display:flex;align-items:center;gap:4px;font-size:13px;color:#333;font-weight:600;" bindtap="showToast" data-msg="位置筛选">
      <text class="iconfont icon-location"></text>
      <text style="max-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">南岸区文化艺术中心...</text>
      <text class="iconfont icon-arrow-down" style="font-size:10px;"></text>
    </view>
    <view style="display:flex;align-items:center;gap:4px;font-size:13px;color:#666;" bindtap="showToast" data-msg="综合推荐">
      <text>综合推荐</text>
      <text class="iconfont icon-arrow-down" style="font-size:10px;"></text>
    </view>
    <view style="display:flex;align-items:center;gap:4px;font-size:13px;color:#666;" bindtap="showToast" data-msg="价格排序">
      <text>价格</text>
      <text style="font-size:10px;">⇅</text>
    </view>
    <view style="display:flex;align-items:center;gap:4px;font-size:13px;color:#666;margin-left:auto;" bindtap="showToast" data-msg="筛选">
      <text>筛选</text>
      <text class="iconfont icon-filter" style="font-size:14px;"></text>
    </view>
  </view>

  <!-- 商品瀑布流 -->
  <view style="padding:10px;display:grid;grid-template-columns:1fr 1fr;gap:10px;">
    <view wx:for="{{products}}" wx:key="id" style="background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.04);position:relative;" bindtap="showToast" data-msg="{{item.name}}">
      <view style="height:160px;background:#f8f9fa;position:relative;overflow:hidden;">
        <image src="{{item.image}}" mode="aspectFill" style="width:100%;height:100%;{{item.soldOut ? 'opacity:0.5;' : ''}}" />
        <view wx:if="{{item.tag}}" style="position:absolute;top:8px;right:8px;background:var(--primary);color:white;font-size:10px;padding:2px 8px;border-radius:4px;">{{item.tag}}</view>
        <view wx:if="{{item.soldOut}}" style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(0,0,0,0.3);">
          <view style="width:60px;height:60px;border:3px solid white;border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-size:14px;font-weight:700;">已售</view>
          <text style="color:white;font-size:12px;margin-top:4px;">Sold out</text>
        </view>
      </view>
      <view style="padding:10px;">
        <view style="font-size:14px;font-weight:700;color:#333;margin-bottom:4px;">{{item.name}}</view>
        <view style="display:flex;gap:6px;margin-bottom:6px;flex-wrap:wrap;">
          <view wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this" style="background:{{t.bg}};color:{{t.color}};font-size:11px;padding:2px 6px;border-radius:4px;">{{t.text}}</view>
        </view>
        <view wx:if="{{!item.soldOut}}">
          <view style="font-size:12px;color:#999;margin-bottom:4px;">{{item.stock}}</view>
          <view style="color:var(--danger);font-size:18px;font-weight:800;">¥{{item.price}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
