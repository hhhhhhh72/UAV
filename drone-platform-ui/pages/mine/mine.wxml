<view class="container">
  <!-- 头部背景 -->
  <view style="background:linear-gradient(135deg,#8e9aaf,#6c7a94);padding:20px 16px 40px;border-radius:0 0 24px 24px;position:relative;">
    <view style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
      <view style="display:flex;align-items:center;gap:12px;">
        <image src="{{userInfo.avatar || '/images/default-avatar.png'}}" style="width:56px;height:56px;background:#4caf50;border-radius:50%;" mode="aspectFill" />
        <view>
          <view style="color:white;font-size:17px;font-weight:700;">{{userInfo.name || 'wx_obVhC11w'}}</view>
          <view style="display:inline-flex;align-items:center;gap:4px;background:rgba(255,255,255,0.2);padding:2px 10px;border-radius:12px;margin-top:4px;">
            <text class="iconfont icon-check" style="color:white;font-size:10px;"></text>
            <text style="color:white;font-size:11px;">{{userInfo.role || '飞手'}}</text>
          </view>
        </view>
      </view>
      <view style="display:flex;gap:10px;">
        <view class="header-icon-white" bindtap="showToast" data-msg="下载APP"><text class="iconfont icon-download"></text></view>
        <view class="header-icon-white" bindtap="showToast" data-msg="消息通知"><text class="iconfont icon-bell"></text></view>
        <view class="header-icon-white" bindtap="showToast" data-msg="设置"><text class="iconfont icon-settings"></text></view>
      </view>
    </view>
  </view>

  <!-- 我的订单 -->
  <view class="card" style="margin:-20px 16px 12px;padding:16px;position:relative;z-index:5;">
    <view style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
      <text style="font-size:16px;font-weight:700;color:#1a1a1a;">我的订单</text>
      <text style="font-size:13px;color:#999;" bindtap="showToast" data-msg="查看全部订单">查看全部 ></text>
    </view>
    <view style="display:flex;justify-content:space-around;">
      <view wx:for="{{orders}}" wx:key="key" style="display:flex;flex-direction:column;align-items:center;gap:6px;" bindtap="showToast" data-msg="{{item.label}}">
        <view style="width:40px;height:40px;background:#f5f5f5;border-radius:10px;display:flex;align-items:center;justify-content:center;">
          <text class="iconfont {{item.icon}}" style="font-size:22px;color:#666;"></text>
        </view>
        <text style="font-size:12px;color:#666;">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 飞手推广 -->
  <view style="margin:0 16px 12px;background:linear-gradient(135deg,#fff8e1,#ffecb3);border-radius:14px;padding:14px;display:flex;align-items:center;justify-content:space-between;" bindtap="showToast" data-msg="飞手推广">
    <view style="display:flex;align-items:center;gap:10px;">
      <view style="width:40px;height:40px;background:#ff9800;border-radius:10px;display:flex;align-items:center;justify-content:center;">
        <text class="iconfont icon-share" style="color:white;font-size:20px;"></text>
      </view>
      <view>
        <view style="font-size:15px;font-weight:700;color:#333;">飞手推广</view>
        <view style="font-size:12px;color:#e65100;margin-top:2px;">邀请飞手认证 · <text style="font-weight:700;">认证得积分 · 积分可提现</text></view>
      </view>
    </view>
    <view style="background:#fff;border:1px solid #ff9800;color:#ff9800;padding:4px 12px;border-radius:14px;font-size:12px;font-weight:600;">去推广 ></view>
  </view>

  <!-- 我的服务 -->
  <view class="card" style="margin:0 16px 12px;padding:16px;">
    <view style="font-size:16px;font-weight:700;color:#1a1a1a;margin-bottom:14px;">我的服务</view>
    <view style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px 8px;">
      <view wx:for="{{services}}" wx:key="key" style="display:flex;flex-direction:column;align-items:center;gap:6px;" bindtap="showToast" data-msg="{{item.label}}">
        <view style="width:40px;height:40px;background:{{item.bg}};border-radius:10px;display:flex;align-items:center;justify-content:center;">
          <text class="iconfont {{item.icon}}" style="font-size:20px;color:{{item.color}};"></text>
        </view>
        <text style="font-size:12px;color:#666;">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 认证与工具 -->
  <view class="card" style="margin:0 16px 12px;padding:16px;">
    <view style="font-size:16px;font-weight:700;color:#1a1a1a;margin-bottom:14px;">认证与工具</view>
    <view style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px 8px;">
      <view wx:for="{{tools}}" wx:key="key" style="display:flex;flex-direction:column;align-items:center;gap:6px;" bindtap="showToast" data-msg="{{item.label}}">
        <view style="width:40px;height:40px;background:{{item.bg}};border-radius:10px;display:flex;align-items:center;justify-content:center;">
          <text class="iconfont {{item.icon}}" style="font-size:20px;color:{{item.color}};"></text>
        </view>
        <text style="font-size:12px;color:#666;">{{item.label}}</text>
      </view>
    </view>
  </view>
</view>
