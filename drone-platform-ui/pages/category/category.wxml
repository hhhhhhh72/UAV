<view class="container">
  <view style="background:#fff;padding:10px 16px;display:flex;align-items:center;gap:10px;border-bottom:1px solid #f0f0f0;">
    <view style="flex:1;background:#f5f5f5;border-radius:20px;height:36px;display:flex;align-items:center;padding:0 14px;gap:8px;" bindtap="showToast" data-msg="搜索">
      <text class="iconfont icon-search" style="color:#999;font-size:14px;"></text>
      <text style="color:#999;font-size:13px;">输入无人机名称/品牌/型号</text>
    </view>
    <view style="display:flex;gap:3px;">
      <view style="width:5px;height:5px;background:#333;border-radius:50%;"></view>
      <view style="width:5px;height:5px;background:#333;border-radius:50%;"></view>
      <view style="width:5px;height:5px;background:#333;border-radius:50%;"></view>
    </view>
  </view>

  <view style="display:flex;height:calc(100vh - 100px);">
    <!-- 左侧分类 -->
    <scroll-view scroll-y style="width:90px;background:#f8f9fa;flex-shrink:0;">
      <view wx:for="{{categories}}" wx:key="id" 
        style="padding:16px 0;text-align:center;font-size:14px;{{currentCategory === item.id ? 'font-weight:700;color:#ff4d4f;border-left:3px solid #ff4d4f;background:#fff;' : 'color:#666;'}}"
        bindtap="switchCategory" data-id="{{item.id}}">
        {{item.name}}
      </view>
    </scroll-view>

    <!-- 右侧内容 -->
    <scroll-view scroll-y style="flex:1;padding:12px;" bindscrolltolower="loadMore">
      <!-- 品牌 -->
      <view style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
        <text style="font-size:15px;font-weight:700;">{{currentCategoryName}} · 品牌</text>
        <text style="font-size:13px;color:var(--primary);" bindtap="showToast" data-msg="全部品牌">全部 ></text>
      </view>
      <view style="display:flex;gap:10px;margin-bottom:16px;">
        <view wx:for="{{brands}}" wx:key="id" style="width:80px;height:80px;background:#fff;border:1px solid #e0e0e0;border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;" bindtap="showToast" data-msg="{{item.name}}">
          <image src="{{item.logo}}" style="width:40px;height:40px;" mode="aspectFit" />
          <text style="font-size:12px;color:#666;">{{item.name}}</text>
        </view>
      </view>

      <!-- 产品列表 -->
      <view style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
        <text style="font-size:15px;font-weight:700;">{{currentCategoryName}} · 大疆</text>
        <text style="font-size:13px;color:var(--primary);" bindtap="showToast" data-msg="全部产品">全部 ></text>
      </view>
      <view style="display:flex;flex-direction:column;gap:12px;">
        <view wx:for="{{products}}" wx:key="id" style="background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.06);" bindtap="showToast" data-msg="{{item.name}}">
          <view style="height:140px;position:relative;overflow:hidden;">
            <image src="{{item.image}}" mode="aspectFill" style="width:100%;height:100%;" />
            <view style="position:absolute;top:16px;left:16px;color:white;">
              <view style="font-size:22px;font-weight:800;letter-spacing:1px;text-shadow:0 2px 8px rgba(0,0,0,0.5);">{{item.name}}</view>
              <view style="font-size:12px;margin-top:4px;opacity:0.95;text-shadow:0 1px 4px rgba(0,0,0,0.5);">{{item.slogan}}</view>
            </view>
            <view style="position:absolute;bottom:16px;left:16px;background:rgba(255,255,255,0.9);color:#1a3a2f;padding:4px 14px;border-radius:14px;font-size:12px;font-weight:700;">马上了解</view>
          </view>
        </view>
      </view>

      <view wx:if="{{loadingMore}}" style="text-align:center;padding:16px;color:#999;font-size:13px;">加载中...</view>
    </scroll-view>
  </view>
</view>
