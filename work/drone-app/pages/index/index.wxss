/* ========== SVG图标基础 ========== */
.icon-svg { display: block; flex-shrink: 0; }
.icon-14 { width: 28rpx; height: 28rpx; }
.icon-16 { width: 32rpx; height: 32rpx; }
.icon-18 { width: 36rpx; height: 36rpx; }
.icon-20 { width: 40rpx; height: 40rpx; }
.icon-24 { width: 48rpx; height: 48rpx; }
.icon-28 { width: 56rpx; height: 56rpx; }
.stroke-primary { stroke: #2563eb; }
.stroke-gray { stroke: #94a3b8; }

/* ========== 导航栏 ========== */
.custom-nav {
  background: #0f172a;
  padding: 0 32rpx 24rpx;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.time {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
}

.status-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #ffffff;
  font-size: 22rpx;
}

.network { font-size: 20rpx; font-weight: 600; }

.battery {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.battery-body {
  width: 36rpx;
  height: 18rpx;
  border: 2rpx solid rgba(255,255,255,0.6);
  border-radius: 4rpx;
  padding: 2rpx;
  position: relative;
}

.battery-level {
  height: 100%;
  background: #4ade80;
  border-radius: 2rpx;
}

.battery-cap {
  width: 4rpx;
  height: 10rpx;
  background: rgba(255,255,255,0.6);
  border-radius: 0 2rpx 2rpx 0;
}

.battery-text { font-size: 20rpx; min-width: 32rpx; text-align: right; }

.location-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.location {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #ffffff;
}

.location-text {
  font-size: 32rpx;
  font-weight: 600;
}

.header-actions {
  display: flex;
  gap: 32rpx;
  align-items: center;
}

.action-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========== 搜索框 ========== */
.search-box {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.search-input-wrapper {
  flex: 1;
  background: rgba(255,255,255,0.1);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  padding: 18rpx 28rpx;
  gap: 12rpx;
  border: 1rpx solid rgba(255,255,255,0.1);
}

.search-input {
  flex: 1;
  color: #ffffff;
  font-size: 28rpx;
  height: 40rpx;
  min-height: 40rpx;
  line-height: 40rpx;
}

.search-placeholder { color: #94a3b8; font-size: 28rpx; }

.search-btn {
  background: #2563eb;
  color: #ffffff;
  border: none;
  padding: 18rpx 40rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  margin: 0;
}
.search-btn::after { border: none; }

/* ========== Banner ========== */
.banner-section { padding: 32rpx; }

.banner-swiper {
  height: 320rpx;
  border-radius: 32rpx;
  overflow: hidden;
}

.banner {
  height: 320rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  padding: 0 48rpx;
  position: relative;
  overflow: hidden;
}

.banner-content { z-index: 2; max-width: 55%; }

.banner-title {
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  line-height: 1.3;
  display: block;
}

.banner-subtitle {
  color: rgba(255,255,255,0.8);
  font-size: 26rpx;
  display: block;
}

/* ========== CSS无人机 - Banner ========== */
.drone-illustration {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 280rpx;
  height: 280rpx;
}

.d-body {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 120rpx;
  height: 40rpx;
  background: rgba(255,255,255,0.15);
  border: 2rpx solid rgba(255,255,255,0.3);
  border-radius: 8rpx;
}

.d-arm {
  position: absolute;
  width: 60rpx;
  height: 4rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 2rpx;
}
.d-arm-tl { left: 40rpx; top: 100rpx; transform: rotate(-35deg); }
.d-arm-tr { right: 40rpx; top: 100rpx; transform: rotate(35deg); }
.d-arm-bl { left: 40rpx; bottom: 100rpx; transform: rotate(35deg); }
.d-arm-br { right: 40rpx; bottom: 100rpx; transform: rotate(-35deg); }

.d-prop {
  position: absolute;
  width: 40rpx;
  height: 12rpx;
  background: rgba(255,255,255,0.2);
  border: 2rpx solid rgba(255,255,255,0.4);
  border-radius: 50%;
}
.d-prop-tl { left: 20rpx; top: 80rpx; }
.d-prop-tr { right: 20rpx; top: 80rpx; }
.d-prop-bl { left: 20rpx; bottom: 80rpx; }
.d-prop-br { right: 20rpx; bottom: 80rpx; }

.d-camera {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 24rpx;
  height: 24rpx;
  background: rgba(59,130,246,0.5);
  border-radius: 50%;
}

.d-tank {
  position: absolute;
  left: 50%;
  bottom: 60rpx;
  transform: translateX(-50%);
  width: 60rpx;
  height: 30rpx;
  background: rgba(255,255,255,0.1);
  border: 2rpx solid rgba(255,255,255,0.2);
  border-radius: 6rpx;
}

.banner-dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 24rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e2e8f0;
  transition: all 0.3s;
}
.dot.active {
  width: 32rpx;
  border-radius: 6rpx;
  background: #2563eb;
}

/* ========== 公告栏 ========== */
.notice-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #ffffff;
  margin: 0 32rpx;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.05);
}

.notice-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.notice-tag {
  background: #fee2e2;
  color: #dc2626;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.notice-text { font-size: 28rpx; color: #1e293b; font-weight: 500; }
.notice-date { color: #94a3b8; font-size: 26rpx; }

/* ========== 功能图标 ========== */
.features-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.feature-icon-wrapper {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  border: 1rpx solid #e2e8f0;
}

.feature-label { font-size: 24rpx; color: #1e293b; font-weight: 500; }

/* ========== 任务发布 + 商品入口 ========== */
.action-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}

.action-card {
  border-radius: 32rpx;
  padding: 40rpx;
  position: relative;
  overflow: hidden;
}

.task-card {
  background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
  color: #ffffff;
  height: 100%;
  display: flex;
  flex-direction: column;
  min-height: 360rpx;
}

.task-title { font-size: 40rpx; font-weight: 700; margin-bottom: 32rpx; display: block; }

.task-features {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
  flex: 1;
}

.task-feature {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.feature-dot {
  width: 8rpx;
  height: 8rpx;
  background: #60a5fa;
  border-radius: 50%;
  flex-shrink: 0;
}

.task-btn {
  background: #2563eb;
  color: #ffffff;
  border: none;
  padding: 20rpx 40rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  width: fit-content;
  line-height: 1;
  margin: 0;
}
.task-btn::after { border: none; }

.product-entries {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.product-card {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 168rpx;
  padding: 32rpx;
}

.product-entry-title { font-size: 34rpx; font-weight: 700; color: #1e293b; display: block; margin-bottom: 8rpx; }

.product-link {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #64748b;
  font-size: 26rpx;
}

.link-btn {
  width: 44rpx;
  height: 44rpx;
  background: #0f172a;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 小无人机CSS */
.mini-drone {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  align-self: flex-end;
  margin-top: 16rpx;
}

.md-body {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 48rpx;
  height: 16rpx;
  background: #e2e8f0;
  border: 2rpx solid #94a3b8;
  border-radius: 4rpx;
}

.md-arm {
  position: absolute;
  width: 28rpx;
  height: 3rpx;
  background: #94a3b8;
  border-radius: 2rpx;
}
.md-tl { left: 16rpx; top: 42rpx; transform: rotate(-35deg); }
.md-tr { right: 16rpx; top: 42rpx; transform: rotate(35deg); }
.md-bl { left: 16rpx; bottom: 42rpx; transform: rotate(35deg); }
.md-br { right: 16rpx; bottom: 42rpx; transform: rotate(-35deg); }

.md-prop {
  position: absolute;
  width: 20rpx;
  height: 6rpx;
  background: #e2e8f0;
  border: 1rpx solid #94a3b8;
  border-radius: 50%;
}
.md-ptl { left: 6rpx; top: 34rpx; }
.md-ptr { right: 6rpx; top: 34rpx; }
.md-pbl { left: 6rpx; bottom: 34rpx; }
.md-pbr { right: 6rpx; bottom: 34rpx; }

/* ========== 筛选栏 ========== */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.location-filter {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 280rpx;
  overflow: hidden;
}

.filter-location-text {
  font-size: 24rpx;
  color: #1e293b;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-btn {
  padding: 10rpx 24rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  border: 1rpx solid #e2e8f0;
  background: #ffffff;
  color: #1e293b;
  display: flex;
  align-items: center;
  gap: 6rpx;
  line-height: 1;
}

.filter-btn.active {
  border-color: #2563eb;
  color: #2563eb;
  background: rgba(37, 99, 235, 0.05);
}

/* ========== 商品列表 ========== */
.product-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 0 32rpx;
  padding-bottom: 160rpx;
}

.product-item {
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  border: 1rpx solid #e2e8f0;
}

.product-img-wrapper {
  width: 100%;
  height: 280rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 商品列表无人机CSS */
.product-drone {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.pd-body {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 64rpx;
  height: 24rpx;
  background: #e2e8f0;
  border: 2rpx solid #94a3b8;
  border-radius: 6rpx;
}

.pd-arm {
  position: absolute;
  width: 36rpx;
  height: 3rpx;
  background: #94a3b8;
  border-radius: 2rpx;
}
.pda-tl { left: 28rpx; top: 56rpx; transform: rotate(-35deg); }
.pda-tr { right: 28rpx; top: 56rpx; transform: rotate(35deg); }
.pda-bl { left: 28rpx; bottom: 56rpx; transform: rotate(35deg); }
.pda-br { right: 28rpx; bottom: 56rpx; transform: rotate(-35deg); }

.pd-prop {
  position: absolute;
  width: 24rpx;
  height: 8rpx;
  background: #e2e8f0;
  border: 1rpx solid #94a3b8;
  border-radius: 50%;
}
.pdp-tl { left: 14rpx; top: 46rpx; }
.pdp-tr { right: 14rpx; top: 46rpx; }
.pdp-bl { left: 14rpx; bottom: 46rpx; }
.pdp-br { right: 14rpx; bottom: 46rpx; }

.pd-camera {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  background: #60a5fa;
  border-radius: 50%;
  opacity: 0.6;
}

.product-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: rgba(0,0,0,0.6);
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.product-detail { padding: 24rpx; }

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price { color: #dc2626; font-size: 32rpx; font-weight: 700; }
.product-distance { font-size: 24rpx; color: #64748b; }

.safe-bottom { height: 140rpx; }

/* ========== 自定义TabBar ========== */
.custom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-top: 1rpx solid #e2e8f0;
  display: flex;
  justify-content: space-around;
  padding-top: 12rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(12rpx + constant(safe-area-inset-bottom));
  z-index: 999;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 40rpx;
}

.tab-icon { width: 48rpx; height: 48rpx; stroke: #94a3b8; }
.tab-label { font-size: 22rpx; color: #94a3b8; }

.tab-item.active .tab-icon { stroke: #2563eb; }
.tab-item.active .tab-label { color: #2563eb; font-weight: 600; }
